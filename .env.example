# Copy to .env.local and fill in from Firebase console -> Project settings -> Your apps -> Web app config
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# "admin" typed in the Username box becomes admin@<this domain>
VITE_ADMIN_EMAIL_DOMAIN=lcc-bsit.app

# true = show the dashed "Demo" hint chips on the sign-in page
VITE_DEMO_MODE=true
