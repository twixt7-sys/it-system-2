# Used by `npm run dev:emulator` — points the app at the local Firebase emulators (no real project needed).
VITE_USE_EMULATORS=true
VITE_FB_API_KEY=demo-key
VITE_FB_AUTH_DOMAIN=demo-lcc.firebaseapp.com
VITE_FB_PROJECT_ID=demo-lcc
VITE_FB_STORAGE_BUCKET=demo-lcc.appspot.com
VITE_FB_MESSAGING_SENDER_ID=0
VITE_FB_APP_ID=demo-app
VITE_ADMIN_EMAIL_DOMAIN=lcc-bsit.app
VITE_DEMO_MODE=true
